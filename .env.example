# Postgres — migrator (superuser, Drizzle Kit / bootstrap only)
DB_HOST=your.db.host
DB_PORT=5432
DB_NAME=fragrance_chemistry_db
DB_USER=fragrance_chemistry_admin
DB_PASSWORD=change-me-migrator
DATABASE_URL_MIGRATOR=postgresql://fragrance_chemistry_admin:change-me-migrator@your.db.host:5432/fragrance_chemistry_db

# Postgres — runtime (RLS enforced, NOBYPASSRLS)
DB_APP_USER=fragrance_chemistry_app
DB_APP_PASSWORD=change-me-app
DATABASE_URL=postgresql://fragrance_chemistry_app:change-me-app@your.db.host:5432/fragrance_chemistry_db

# Redis — db1, ACL user limited to fc:*
REDIS_HOST=your.redis.host
REDIS_PORT=6380
REDIS_DB=1
REDIS_USERNAME=fragrance_chemistry_redis_user
REDIS_PASSWORD=change-me-redis
REDIS_KEY_PREFIX=fc:

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# API
API_PORT=3000
API_CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development

# Notifications — Resend is prepared and does not send until the email channel is wired.
RESEND_API_KEY=
RESEND_FROM=
NOTIFICATIONS_EMAIL_ENABLED=false
